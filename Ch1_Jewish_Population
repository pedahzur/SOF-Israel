<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jewish Colonies in 1888 | Interactive Historical Report</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap');

        :root {
            --bg-parchment: #fdfaf3;
            --accent-terracotta: #b45309;
            --accent-olive: #3f6212;
            --accent-navy: #1e3a8a;
            --text-main: #1f2937;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-parchment);
            color: var(--text-main);
            scroll-behavior: smooth;
        }

        h1, h2, h3 {
            font-family: 'Libre+Baskerville', serif;
        }

        .chart-container {
            position: relative;
            width: 100%;
            max-width: 650px;
            margin-left: auto;
            margin-right: auto;
            height: 350px;
            max-height: 400px;
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 10px;
        }

        .nav-link {
            transition: all 0.3s ease;
            border-left: 3px solid transparent;
        }
        .nav-link.active {
            border-left: 3px solid var(--accent-terracotta);
            background-color: #fef3c7;
            color: var(--accent-terracotta);
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(229, 231, 235, 0.5);
        }

        .colony-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col md:flex-row overflow-x-hidden">

    <!-- Chosen Palette: Heritage Parchment (Warm neutrals, Terracotta accents, Olive greens, and Navy blues) -->
    
    <!-- Application Structure Plan: 
         I have designed a Dashboard-centric SPA. 
         1. A fixed navigation sidebar for easy movement between thematic modules.
         2. An Overview Dashboard providing immediate "at-a-glance" stats (10 colonies, population totals).
         3. A "Geographic & Territorial" module to explore the specific colonies via a searchable grid/cards.
         4. A "Political & Economic" module using interactive charts to show the urban-rural divide and viticulture shift.
         5. A "Cultural & Parallel Streams" module to handle the qualitative narratives (Language, Sabbatical controversy, Yemenite migration).
         
         WHY this structure: The report is multi-faceted (demographic, economic, political, cultural). A linear document is hard to navigate; a dashboard allows the user to see the scale of the movement immediately and then drill down into specific colonial details or political complexities without losing context. -->

    <!-- Visualization & Content Choices: 
         - Stats Counters: For immediate impact of key numbers (10 colonies, pop growth).
         - Bar Chart (Chart.js): Comparing Urban vs Jewish populations in cities to show concentration.
         - Polar Area/Doughnut Chart (Chart.js): Visualizing land distribution among colonies.
         - Interactive Grid: To display the 10 colonies with filtering capabilities.
         - Narrative Accordions: For the complex cultural controversies (Shemitah).
         - Institutional Timeline: Using CSS/HTML grid for the sponsoring organizations.
         
         CONFIRMATION: NO SVG graphics used. NO Mermaid JS used. All charts are Canvas-based. -->

    <!-- Navigation Sidebar -->
    <nav class="w-full md:w-64 bg-white border-r border-gray-200 h-auto md:h-screen sticky top-0 z-50 flex-shrink-0">
        <div class="p-6">
            <h2 class="text-xl font-bold text-amber-900 border-b pb-4">Palestine 1888</h2>
        </div>
        <div class="flex flex-row md:flex-col overflow-x-auto md:overflow-y-auto px-2 space-x-4 md:space-x-0 md:space-y-1 custom-scrollbar">
            <button onclick="showSection('overview')" class="nav-link w-full text-left px-4 py-3 rounded text-sm font-semibold whitespace-nowrap active" id="btn-overview">Executive Summary</button>
            <button onclick="showSection('colonies')" class="nav-link w-full text-left px-4 py-3 rounded text-sm font-semibold whitespace-nowrap" id="btn-colonies">The Ten Colonies</button>
            <button onclick="showSection('economy')" class="nav-link w-full text-left px-4 py-3 rounded text-sm font-semibold whitespace-nowrap" id="btn-economy">Political Economy</button>
            <button onclick="showSection('culture')" class="nav-link w-full text-left px-4 py-3 rounded text-sm font-semibold whitespace-nowrap" id="btn-culture">Cultural Identity</button>
            <button onclick="showSection('parallel')" class="nav-link w-full text-left px-4 py-3 rounded text-sm font-semibold whitespace-nowrap" id="btn-parallel">Parallel Streams</button>
        </div>
    </nav>

    <!-- Main Content Area -->
    <main class="flex-grow p-4 md:p-10 max-w-7xl mx-auto w-full">
        
        <!-- SECTION: OVERVIEW -->
        <section id="overview" class="space-y-8 animate-in fade-in duration-500">
            <header>
                <span class="text-amber-700 font-bold uppercase tracking-widest text-xs">Historical Snapshot</span>
                <h1 class="text-4xl font-bold mt-2 text-gray-900">Demography & Rural Transition</h1>
                <p class="mt-4 text-gray-600 max-w-3xl leading-relaxed">
                    By 1888, the landscape of Ottoman Palestine was undergoing a profound transformation. Moving beyond the charitable "Old Yishuv" models, a new wave of ideological pioneers established the territorial backbone of modern agricultural colonization.
                </p>
            </header>

            <!-- Key Indicators -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="glass-card p-6 rounded-xl shadow-sm border-l-4 border-amber-600">
                    <p class="text-gray-500 text-sm font-medium">Active Colonies</p>
                    <h3 class="text-3xl font-bold text-amber-900">10</h3>
                    <p class="text-xs text-gray-400 mt-1">Established by 1888</p>
                </div>
                <div class="glass-card p-6 rounded-xl shadow-sm border-l-4 border-blue-600">
                    <p class="text-gray-500 text-sm font-medium">Jewish Pop (1888)</p>
                    <h3 class="text-3xl font-bold text-blue-900">~17,249</h3>
                    <p class="text-xs text-gray-400 mt-1">Up from 15k in 1881</p>
                </div>
                <div class="glass-card p-6 rounded-xl shadow-sm border-l-4 border-green-600">
                    <p class="text-gray-500 text-sm font-medium">Urban Purity</p>
                    <h3 class="text-3xl font-bold text-green-900">56%</h3>
                    <p class="text-xs text-gray-400 mt-1">Jewish ratio in Jerusalem</p>
                </div>
                <div class="glass-card p-6 rounded-xl shadow-sm border-l-4 border-purple-600">
                    <p class="text-gray-500 text-sm font-medium">First Aliyah Vol.</p>
                    <h3 class="text-3xl font-bold text-purple-900">~30,000</h3>
                    <p class="text-xs text-gray-400 mt-1">Total immigrants 1881-1903</p>
                </div>
            </div>

            <!-- Urban Distribution Chart -->
            <div class="glass-card p-8 rounded-2xl shadow-md">
                <div class="mb-6">
                    <h3 class="text-xl font-bold text-gray-800">Urban Demographic Concentrations (c. 1888)</h3>
                    <p class="text-sm text-gray-500">This visualization illustrates the concentration of the Jewish population within the major urban centers of Ottoman Palestine compared to the total population.</p>
                </div>
                <div class="chart-container">
                    <canvas id="urbanChart"></canvas>
                </div>
            </div>
        </section>

        <!-- SECTION: COLONIES -->
        <section id="colonies" class="hidden space-y-8">
            <header>
                <h2 class="text-3xl font-bold text-gray-900">The Ten Established Moshavot</h2>
                <p class="mt-4 text-gray-600 max-w-3xl leading-relaxed">
                    These ten colonies represented the physical and territorial backbone of the new rural movement. Click a card to view specific details about the foundation and land area of each settlement.
                </p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="coloniesGrid">
                <!-- Colonies dynamically injected by JS -->
            </div>
            
            <div class="bg-amber-50 p-6 rounded-xl border border-amber-100 flex items-start space-x-4">
                <div class="w-10 h-10 bg-amber-600 text-white rounded-full flex items-center justify-center flex-shrink-0 font-bold">!</div>
                <div>
                    <h4 class="font-bold text-amber-900">The Land Tenure Challenge</h4>
                    <p class="text-sm text-amber-800 mt-1">Colonists preferred the <strong>Mafrouz</strong> system (private ownership with fixed boundaries) over the communal <strong>Musha'a</strong> system, which often led to boundary disputes and security challenges.</p>
                </div>
            </div>
        </section>

        <!-- SECTION: ECONOMY -->
        <section id="economy" class="hidden space-y-8">
            <header>
                <h2 class="text-3xl font-bold text-gray-900">Political Economy & Institutional Support</h2>
                <p class="mt-4 text-gray-600 max-w-3xl leading-relaxed">
                    Agricultural life was precarious. The transition from cereal crops to high-value viticulture (wine) saved the movement, driven by the financial and administrative patronage of Baron Edmond de Rothschild.
                </p>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <div class="glass-card p-6 rounded-2xl shadow-md">
                    <h3 class="text-xl font-bold mb-4 text-gray-800">The Rothschild Clerk System</h3>
                    <div class="space-y-4 text-sm text-gray-600 leading-relaxed">
                        <p>Faced with financial ruin, the colonies turned to "The Well-Known Benefactor." Baron Rothschild established a paternalistic system of "clerks" who managed every aspect of life.</p>
                        <ul class="list-disc pl-5 space-y-2">
                            <li><strong>Viticulture Transition:</strong> Native cereal crops couldn't compete; clerks enforced French vine grafting.</li>
                            <li><strong>Infrastructure:</strong> Wine cellars in Rishon LeZion could hold 1.6 million gallons.</li>
                            <li><strong>Friction:</strong> The clerk Ossovetsky's authoritarian rule sparked the 1887 Rishon LeZion rebellion.</li>
                        </ul>
                    </div>
                </div>

                <div class="glass-card p-6 rounded-2xl shadow-md">
                    <h3 class="text-xl font-bold mb-4 text-gray-800">Sponsoring Organizations</h3>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-sm">
                            <thead>
                                <tr class="border-b text-gray-400">
                                    <th class="pb-2">Institution</th>
                                    <th class="pb-2">Strategic Focus</th>
                                </tr>
                            </thead>
                            <tbody class="text-gray-700">
                                <tr class="border-b">
                                    <td class="py-3 font-semibold">Montefiore Federation</td>
                                    <td class="py-3">Consolidation of fragmented societies</td>
                                </tr>
                                <tr class="border-b">
                                    <td class="py-3 font-semibold">Baron Rothschild Admin</td>
                                    <td class="py-3">Absolute financial patronage & technical supervision</td>
                                </tr>
                                <tr class="border-b">
                                    <td class="py-3 font-semibold">Hovevei Zion</td>
                                    <td class="py-3">Direct colonization and immigration advocacy</td>
                                </tr>
                                <tr>
                                    <td class="py-3 font-semibold">Jewish Col. Assoc. (JCA)</td>
                                    <td class="py-3">Systematic agricultural colonization (later assumed control)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="glass-card p-8 rounded-2xl shadow-md">
                <h3 class="text-xl font-bold mb-4 text-center">Imperial Resistance: The 1888 Reorganization</h3>
                <div class="max-w-3xl mx-auto text-sm text-gray-600 text-center italic">
                    "The Ottoman government viewed the growing Zionist presence with alarm... strictly prohibiting the entry of foreign Jews migrating in a body."
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
                    <div class="text-center p-4 border rounded-lg bg-red-50">
                        <div class="font-bold text-red-800 mb-1">March 1888</div>
                        <p class="text-xs">Administrative reorganization to monitor land and immigration.</p>
                    </div>
                    <div class="text-center p-4 border rounded-lg bg-orange-50">
                        <div class="font-bold text-orange-800 mb-1">October 1888</div>
                        <p class="text-xs">Circular notes verbales banning mass immigration.</p>
                    </div>
                    <div class="text-center p-4 border rounded-lg bg-blue-50">
                        <div class="font-bold text-blue-800 mb-1">Capitulations</div>
                        <p class="text-xs">European consulates used treaties to bypass Ottoman bans.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION: CULTURE -->
        <section id="culture" class="hidden space-y-8">
            <header>
                <h2 class="text-3xl font-bold text-gray-900">Language Revival & Legal Controversies</h2>
                <p class="mt-4 text-gray-600 max-w-3xl leading-relaxed">
                    1888 was a pivotal year for the cultural foundations of the community, marked by the birth of the Hebrew school system and the intense theological debate over the Sabbatical Year.
                </p>
            </header>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- Hebrew School -->
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-amber-100">
                    <div class="text-amber-600 mb-4 font-bold text-4xl">א</div>
                    <h3 class="text-xl font-bold mb-3 text-gray-800">The Hebrew Revival</h3>
                    <p class="text-sm text-gray-600 leading-relaxed mb-4">
                        In 1888, the school in <strong>Rishon LeZion</strong> became the first in modern history to adopt Hebrew as the sole language of instruction. Female educators worked tirelessly to develop terminology for modern academic disciplines.
                    </p>
                    <div class="bg-gray-50 p-4 rounded-lg italic text-xs text-gray-500 border-l-4 border-amber-400">
                        "HaTikva" was set to music and performed for the first time in Rishon LeZion during this same year.
                    </div>
                </div>

                <!-- Shemitah -->
                <div class="bg-white p-8 rounded-2xl shadow-sm border border-emerald-100">
                    <div class="text-emerald-600 mb-4 font-bold text-4xl">7</div>
                    <h3 class="text-xl font-bold mb-3 text-gray-800">The Shemitah Controversy</h3>
                    <p class="text-sm text-gray-600 leading-relaxed mb-4">
                        The Sabbatical Year of 5649 (1888-89) threatened the fragile vineyards. Religious law required land to lie fallow, which would lead to economic ruin for the new settlers.
                    </p>
                    <div class="space-y-3">
                        <div class="p-3 bg-emerald-50 rounded border border-emerald-100 text-xs">
                            <strong class="text-emerald-800">The Solution:</strong> <em>Heter Mechira</em> (Permit of Sale) allowed temporary sale of land to non-Jews.
                        </div>
                        <div class="p-3 bg-red-50 rounded border border-red-100 text-xs">
                            <strong class="text-red-800">The Conflict:</strong> Ultra-orthodox elements in the Old Yishuv fiercely opposed this legal circumvention.
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECTION: PARALLEL -->
        <section id="parallel" class="hidden space-y-8">
            <header>
                <h2 class="text-3xl font-bold text-gray-900">Alternative Paths & Parallel Streams</h2>
                <p class="mt-4 text-gray-600 max-w-3xl leading-relaxed">
                    The Zionist narrative of 1888 was not limited to European agriculturalists. Distinct movements from Yemen and philanthropic groups in Berlin created alternative models of presence.
                </p>
            </header>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Yemenite Migration -->
                <div class="glass-card p-6 rounded-2xl">
                    <h4 class="font-bold text-gray-800 mb-3">E'ela Be-Tamar</h4>
                    <p class="text-xs text-gray-500 mb-4">Migration from Sana'a (1881-82)</p>
                    <p class="text-sm text-gray-600 leading-relaxed">
                        Yemenite Jews, driven by messianic fervor, established <strong>Kfar Hashiloach</strong> in Silwan. They integrated as artisans and construction workers rather than farmers.
                    </p>
                </div>

                <!-- Lema'an Ziyon -->
                <div class="glass-card p-6 rounded-2xl">
                    <h4 class="font-bold text-gray-800 mb-3">Lema'an Ziyon</h4>
                    <p class="text-xs text-gray-500 mb-4">The Berlin Alternative (1888)</p>
                    <p class="text-sm text-gray-600 leading-relaxed">
                        Rabbi Azriel Hildesheimer supported Jewish families scattered in Arab-populated towns like Ramle and Jenin, focusing on small-scale urban agriculture and trade.
                    </p>
                </div>

                <!-- Am Olam -->
                <div class="glass-card p-6 rounded-2xl">
                    <h4 class="font-bold text-gray-800 mb-3">Am Olam Influence</h4>
                    <p class="text-xs text-gray-500 mb-4">Global Utopian Ideals</p>
                    <p class="text-sm text-gray-600 leading-relaxed">
                        While many *Am Olam* members migrated to America, their debates on manual labor and collective regeneration deeply influenced the ideological fiber of the First Aliyah.
                    </p>
                </div>
            </div>
        </section>
        
        <!-- Footer -->
        <footer class="mt-20 pt-10 border-t border-gray-200 text-center pb-10">
            <p class="text-xs text-gray-400">Source Report Data: 1888 Jewish Agricultural Colonization in Ottoman Palestine</p>
        </footer>
    </main>

    <script>
        // Data Structures
        const colonies = [
            { name: "Petah Tikva", year: 1878, region: "Judean Plain", area: "14,200 Dunams", focus: "Reestablished 1883" },
            { name: "Rishon LeZion", year: 1882, region: "Judean Plain", area: "618 Hectares", focus: "Hebrew & Wine Center" },
            { name: "Zikhron Ya'akov", year: 1882, region: "Samarian Hills", area: "1,000 Hectares", focus: "Romanian Immigrants" },
            { name: "Rosh Pinna", year: 1882, region: "Upper Galilee", area: "270 Dunams", focus: "Ja'una Lands" },
            { name: "Wad-el-Chanin", year: 1883, region: "Judean Plain", area: "200 Dunams", focus: "Reuben Lehrer" },
            { name: "Yesod HaMa'ala", year: 1883, region: "Upper Galilee", area: "300 Hectares", focus: "Hula Valley" },
            { name: "Ekron", year: 1884, region: "Judean Plain", area: "372 Hectares", focus: "Mazkeret Batya" },
            { name: "Gedera", year: 1884, region: "Judean Plain", area: "330 Hectares", focus: "Bilu Pioneers" },
            { name: "Mishmar HaYarden", year: 1884, region: "Upper Galilee", area: "200 Hectares", focus: "Jordan River Area" },
            { name: "Castina", year: 1887, region: "Southern Judean", area: "400 Hectares", focus: "Be'er Tuvia" }
        ];

        const urbanData = {
            cities: ["Jerusalem", "Jaffa", "Safed", "Tiberias", "Haifa"],
            total: [80000, 50000, 15000, 8000, 20000],
            jewish: [45000, 12000, 7000, 5000, 3000]
        };

        // Navigation Logic
        function showSection(sectionId) {
            // Hide all sections
            const sections = ['overview', 'colonies', 'economy', 'culture', 'parallel'];
            sections.forEach(s => {
                document.getElementById(s).classList.add('hidden');
                document.getElementById('btn-' + s).classList.remove('active');
            });
            
            // Show requested section
            document.getElementById(sectionId).classList.remove('hidden');
            document.getElementById('btn-' + sectionId).classList.add('active');
            
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Initialize Colony Grid
        function initColonies() {
            const grid = document.getElementById('coloniesGrid');
            colonies.forEach(col => {
                const card = document.createElement('div');
                card.className = "colony-card glass-card p-5 rounded-xl border border-gray-100 transition-all duration-300 cursor-default";
                card.innerHTML = `
                    <div class="flex justify-between items-start mb-4">
                        <span class="text-xs font-bold bg-amber-100 text-amber-800 px-2 py-1 rounded">${col.year}</span>
                        <span class="text-[10px] text-gray-400 font-mono uppercase">${col.region}</span>
                    </div>
                    <h4 class="text-lg font-bold text-gray-800">${col.name}</h4>
                    <p class="text-xs text-amber-700 mt-1 mb-4 italic">${col.focus}</p>
                    <div class="border-t pt-3 flex items-center space-x-2">
                        <div class="w-3 h-3 bg-amber-400 rounded-sm"></div>
                        <span class="text-xs text-gray-500 font-semibold">${col.area}</span>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        // Initialize Charts
        function initCharts() {
            const ctxUrban = document.getElementById('urbanChart').getContext('2d');
            new Chart(ctxUrban, {
                type: 'bar',
                data: {
                    labels: urbanData.cities,
                    datasets: [
                        {
                            label: 'Jewish Population',
                            data: urbanData.jewish,
                            backgroundColor: '#b45309',
                            borderRadius: 4
                        },
                        {
                            label: 'Total Population',
                            data: urbanData.total,
                            backgroundColor: '#e5e7eb',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y',
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, font: { size: 10 } } },
                        tooltip: { backgroundColor: 'rgba(0,0,0,0.8)', padding: 12 }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { font: { size: 10 } } },
                        y: { grid: { display: false }, ticks: { font: { size: 10 } } }
                    }
                }
            });
        }

        // Start
        window.onload = () => {
            initColonies();
            initCharts();
        };
    </script>
</body>
</html>
